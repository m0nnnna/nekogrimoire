---
layout: base.njk
title: Gallery
---
{% import "macros.njk" as m %}

<div class="toolbar">
  <input type="search" id="search" placeholder="Search prompts, tags, or artists…" aria-label="Search prompts" />
  <div class="count" id="count">{{ prompts.length }} prompt{{ "s" if prompts.length != 1 }}</div>
</div>

<div class="grid" id="grid">
  {% for prompt in prompts %}
  <div class="grid-item"
       data-search="{{ (prompt.title + ' ' + (prompt.credit.name if prompt.credit else '') + ' ' + prompt.tags | join(' ')) | lower }}">
    {{ m.card(prompt) }}
  </div>
  {% endfor %}
</div>

<p class="empty-state" id="empty" hidden>No prompts match your search. Try a different word, or <a href="{{ '/submit/' | url }}">add one</a>.</p>

{% if prompts.length == 0 %}
<p class="empty-state">No prompts yet — be the first to <a href="{{ '/submit/' | url }}">add one to the grimoire</a>.</p>
{% endif %}

<script>
  (function () {
    var search = document.getElementById("search");
    var items = Array.prototype.slice.call(document.querySelectorAll("#grid .grid-item"));
    var count = document.getElementById("count");
    var empty = document.getElementById("empty");

    search.addEventListener("input", function () {
      var q = search.value.trim().toLowerCase();
      var visible = 0;
      items.forEach(function (item) {
        var match = !q || item.getAttribute("data-search").indexOf(q) !== -1;
        item.hidden = !match;
        if (match) visible++;
      });
      count.textContent = visible + " prompt" + (visible !== 1 ? "s" : "");
      empty.hidden = visible !== 0;
    });
  })();
</script>
